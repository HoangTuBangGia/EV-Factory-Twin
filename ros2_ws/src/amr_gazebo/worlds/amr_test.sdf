<?xml version="1.0"?>
<sdf version="1.9">
  <world name="amr_test">
    <gravity>0 0 0</gravity>
    <physics name="deterministic" type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor><real_time_update_rate>1000</real_time_update_rate></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><direction>-0.5 0.5 -1</direction></light>
    <model name="factory_floor">
      <static>true</static>
      <pose>60 20 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>120 40</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>120 40</size></plane></geometry></visual>
      </link>
    </model>
    <model name="north_boundary">
      <static>true</static><pose>60 40 0.5 0 0 0</pose><link name="link">
        <collision name="collision"><geometry><box><size>120 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>120 0.2 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="south_boundary">
      <static>true</static><pose>60 0 0.5 0 0 0</pose><link name="link">
        <collision name="collision"><geometry><box><size>120 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>120 0.2 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="west_boundary">
      <static>true</static><pose>0 20 0.5 0 0 0</pose><link name="link">
        <collision name="collision"><geometry><box><size>0.2 40 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 40 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="east_boundary">
      <static>true</static><pose>120 20 0.5 0 0 0</pose><link name="link">
        <collision name="collision"><geometry><box><size>0.2 40 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 40 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="giga_press_obstacle">
      <static>true</static><pose>51 32 1 0 0 0</pose><link name="link">
        <collision name="collision"><geometry><box><size>10 6 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 6 2</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
