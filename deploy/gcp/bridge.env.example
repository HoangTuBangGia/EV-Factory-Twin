# Install as /etc/ev-factory-twin/bridge.env with owner root:root and mode 0600.
# Never commit the populated file.
EV_TWIN_ROOT=/opt/ev-factory-twin
ROS_DOMAIN_ID=42
TELEMETRY_BACKEND_URL=https://YOUR_CLOUD_RUN_HOST
EDGE_TELEMETRY_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BRIDGE_ID=gcp-edge-environment
