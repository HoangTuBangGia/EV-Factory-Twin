# Immutable runtime identity shared by the Gazebo launch and telemetry bridge.
# Copy to /etc/ev-factory-twin/runtime.env only after a Monitor approves the
# matching scenario, then restart simulation before retrying its Apply command.
RUNTIME_LAYOUT_ID=LAYOUT-DEFAULT
RUNTIME_LAYOUT_VERSION=3
RUNTIME_ROUTE_ID=BATTERY_DELIVERY
RUNTIME_ROBOT_SPEED_MPS=1.2
RUNTIME_CHARGER_COUNT=2
RUNTIME_DEMAND_INTERVAL_SECONDS=8.0

# Optional generated configuration files for a non-default layout/fleet.
# ROBOTS_CONFIG=/etc/ev-factory-twin/runtime/robots.json
# STATIONS_CONFIG=/etc/ev-factory-twin/runtime/stations.json
