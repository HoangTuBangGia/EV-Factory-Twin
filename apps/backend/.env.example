# Copy this file to .env and adjust as needed.

APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# Local Supabase CLI defaults. Run `make supabase-start`, then confirm the values
# with `make supabase-status`. Never expose this URL to Next.js.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL_MODE=disable

# Render + hosted Supabase use the hosted connection string and TLS instead:
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
# DATABASE_SSL_MODE=require

# Supabase Auth JWT verification. Use the local API URL during development.
# For Render, replace it with https://YOUR_PROJECT_REF.supabase.co.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_TTL_SECONDS=3600
SUPABASE_JWKS_REQUEST_TIMEOUT_SECONDS=5
SUPABASE_JWKS_UNKNOWN_KID_COOLDOWN_SECONDS=30
SUPABASE_JWT_LEEWAY_SECONDS=30
SUPABASE_JWT_VERIFICATION_MAX_WORKERS=4
SUPABASE_JWT_VERIFICATION_MAX_IN_FLIGHT=32
WEBSOCKET_AUTH_TIMEOUT_SECONDS=5

# Opaque machine credential for POST /internal/v1/telemetry. Generate at least
# 32 random characters and keep it backend/edge-only. Do not reuse Supabase keys.
EDGE_TELEMETRY_SHARED_SECRET=
# Reject source timestamps farther ahead of backend UTC than this (0-300 seconds).
EDGE_TELEMETRY_MAX_FUTURE_SKEW_SECONDS=5
RUNTIME_HEALTH_SWEEP_SECONDS=1
STALE_TELEMETRY_SECONDS=10
BRIDGE_DISCONNECT_SECONDS=5
CONGESTION_DISTANCE_METERS=1.5
RUNTIME_LOW_BATTERY_PERCENT=20

MOCK_FACTORY_ENABLED=true
MOCK_ROBOT_COUNT=5
MOCK_TASK_INTERVAL_SECONDS=8
MOCK_ROBOT_SPEED_MPS=1.2
MOCK_SIMULATION_SPEED=1
