# Copy this file to .env and adjust as needed.

APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection used by the backend only. For SQLAlchemy + asyncpg,
# prefer the `postgresql+asyncpg://` scheme. Never expose this URL to Next.js.
DATABASE_URL=
DATABASE_SSL_MODE=require

# Supabase Auth JWT verification. Issuer/JWKS default to the standard paths
# derived from SUPABASE_URL, but may be overridden explicitly when necessary.
SUPABASE_URL=https://your-project-ref.supabase.co
# Required only for POST /api/v1/admin/users/invite. Keep this backend-only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_TTL_SECONDS=3600
SUPABASE_JWKS_REQUEST_TIMEOUT_SECONDS=5
SUPABASE_JWKS_UNKNOWN_KID_COOLDOWN_SECONDS=30
SUPABASE_JWT_LEEWAY_SECONDS=30
SUPABASE_JWT_VERIFICATION_MAX_WORKERS=4
SUPABASE_JWT_VERIFICATION_MAX_IN_FLIGHT=32
WEBSOCKET_AUTH_TIMEOUT_SECONDS=5

MOCK_FACTORY_ENABLED=true
MOCK_ROBOT_COUNT=5
MOCK_TASK_INTERVAL_SECONDS=8
MOCK_ROBOT_SPEED_MPS=1.2
MOCK_SIMULATION_SPEED=1
