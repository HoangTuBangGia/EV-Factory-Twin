# Copy this file to .env and adjust as needed.

APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# Local PostgreSQL. Cloud SQL should be reached through its authenticated connector.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_SSL_MODE=disable

# Generate at least 64 random characters and keep this Backend-only.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=ev-factory-twin
AUTH_JWT_AUDIENCE=ev-factory-twin-browser
AUTH_ACCESS_TOKEN_TTL_SECONDS=28800
AUTH_JWT_LEEWAY_SECONDS=30
WEBSOCKET_AUTH_TIMEOUT_SECONDS=5

# Opaque machine credential for POST /internal/v1/telemetry. Generate at least
# 32 random characters and keep it backend/edge-only. Do not reuse the JWT secret.
EDGE_TELEMETRY_SHARED_SECRET=
# Reject source timestamps farther ahead of backend UTC than this (0-300 seconds).
EDGE_TELEMETRY_MAX_FUTURE_SKEW_SECONDS=5
# Persist only the latest sample per robot/status at this cadence; live WebSocket stays realtime.
TELEMETRY_HISTORY_FLUSH_SECONDS=1
RUNTIME_HEALTH_SWEEP_SECONDS=1
COMMAND_TIMEOUT_SWEEP_SECONDS=1
STALE_TELEMETRY_SECONDS=10
BRIDGE_DISCONNECT_SECONDS=5
RUNTIME_LOW_BATTERY_PERCENT=20

MOCK_FACTORY_ENABLED=true
MOCK_ROBOT_COUNT=5
MOCK_TASK_INTERVAL_SECONDS=8
MOCK_ROBOT_SPEED_MPS=1.2
MOCK_SIMULATION_SPEED=1
