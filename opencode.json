{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,

  "plugin": [
    "@dietrichgebert/ponytail"
  ],

  "enabled_providers": [
    "codelypixverse-openai"
  ],

  "model": "codelypixverse-openai/gpt-5.6-sol",
  "small_model": "codelypixverse-openai/gpt-5.6-sol",

  "subagent_depth": 1,

  "provider": {
    "codelypixverse-openai": {
      "npm": "@ai-sdk/openai",
      "name": "CodeLypixverse OpenAI Responses",

      "options": {
        "baseURL": "https://codelypixverse.com/v1",
        "apiKey": "{env:CODELYPIXVERSE_API_KEY}",
        "timeout": 600000,
        "chunkTimeout": 60000
      },

      "whitelist": [
        "gpt-5.6-sol"
      ],

      "models": {
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol"
        }
      }
    }
  },

  "watcher": {
    "ignore": [
      ".git/**",

      ".venv/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "**/.ruff_cache/**",

      "node_modules/**",
      ".next/**",
      "dist/**",
      "coverage/**",

      "ros2_ws/build/**",
      "ros2_ws/install/**",
      "ros2_ws/log/**"
    ]
  },

  "permission": {
    "read": {
      "*": "allow",

      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",

      ".env.example": "allow",
      "**/.env.example": "allow"
    },

    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "question": "allow",

    "bash": {
      "*": "ask",

      "ls*": "allow",
      "pwd": "allow",
      "find *": "allow",
      "tree*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",

      "python *": "allow",
      "python3 *": "allow",
      "pytest*": "allow",
      "ruff *": "allow",
      "mypy *": "allow",

      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "bun *": "allow",

      "make *": "allow",
      "cmake *": "allow",
      "ctest *": "allow",

      "source /opt/ros/jazzy/setup.bash*": "allow",
      "ros2 *": "allow",
      "rosdep *": "allow",
      "colcon *": "allow",

      "docker compose *": "allow",
      "docker build *": "allow",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git grep*": "allow",

      "sudo *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "pip *": "deny",
      "pip3 *": "deny",
      "python -m pip *": "deny",

      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",

      "rm -rf*": "deny"
    }
  },

  "agent": {
    "build": {
      "description": "Primary engineering orchestrator for the EV Factory Digital Twin",

      "mode": "primary",

      "model": "codelypixverse-openai/gpt-5.6-sol",

      "temperature": 0.1,

      "prompt": "{file:./.opencode/build-prompt.md}",

      "permission": {
        "task": {
          "*": "deny",

          "researcher": "allow",
          "architect": "allow",

          "backend": "allow",
          "frontend": "allow",
          "ros-gazebo": "allow",
          "simulation": "allow",

          "qa-ci": "allow",
          "reviewer": "allow",
          "docs": "allow"
        }
      }
    },

    "plan": {
      "description": "Read-only technical planning and architecture agent",

      "mode": "primary",

      "model": "codelypixverse-openai/gpt-5.6-sol",

      "temperature": 0.1,

      "prompt": "{file:./.opencode/plan-prompt.md}",

      "permission": {
        "edit": "deny",

        "bash": {
          "*": "deny",

          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git rev-parse*": "allow",
          "git ls-files*": "allow",
          "git grep*": "allow"
        },

        "task": {
          "*": "deny",

          "researcher": "allow",
          "architect": "allow",
          "reviewer": "allow"
        }
      }
    }
  }
}